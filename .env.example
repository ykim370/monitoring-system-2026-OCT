# Copy to a local .env for docker --env-file. Never commit your real .env.
# Generate interactively: python3 -m app password
APP_PASSWORD_HASH=replace-with-generated-password-hash
# Exact HTTPS origin, no trailing slash. Your reverse proxy terminates TLS.
APP_ORIGIN=https://your-private-domain.example
APP_DATABASE=/data/workspace.sqlite3
